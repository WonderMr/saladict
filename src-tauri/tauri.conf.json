{
    "productName": "saladict",
    "version": "4.0.1",
    "identifier": "allen.town.focus.saladict",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Daemon",
                "label": "daemon",
                "visible": false,
                "url": "daemon.html"
            }
        ],
        "trayIcon": {
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true
        },
        "security": {
            "csp": "default-src * data: blob:; img-src * 'self' asset: https: data:; style-src * 'unsafe-inline'; worker-src 'self' blob:; script-src * 'unsafe-eval'; connect-src * ipc: http://ipc.localhost;"
        }
    },
    "bundle": {
        "category": "Utility",
        "copyright": "GPLv3",
        "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
        "longDescription": "A cross-platform text translation and ocr software",
        "shortDescription": "Saladict App",
        "externalBin": [],
        "resources": [],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "linux": {
            "deb": {
                "depends": ["libxdo-dev", "libxcb1", "libxrandr2", "tesseract-ocr"]
            },
            "rpm": {
                "depends": ["libxdo-dev", "libxcb1", "libxrandr2", "tesseract-ocr"]
            }
        },
        "macOS": {
            "minimumSystemVersion": "10.13"
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["bas"]
            }
        },
        "updater": {
            "active": true,
            "dialog": false,
            "endpoints": ["https://github.com/allentown521/saladict/releases/download/updater/update.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NUYwQzBBNzUwMUY0RUEKUldUcTlBRjFDZ3hmeGpjbVcwN3dIVnlFbTE0Y1AvU2lVNUthaU5xYmovZ2VDaFV2TnVhRS9GWkUK"
        }
    }
}
